<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    xmlns="sap.m"
    controllerName="zpmckd.ZPM_CKD.ext.controller.ListReportExt"
>
    <table:Column
        id="FioriTools::ColumnExtension0"
        sortProperty="picture"
        filterProperty="picture"
    >
        <table:label>
            <Label
                id="FioriTools::ColumnExtension0Label"
                text="{/#ZPMI_CKD_CUSTType/picture/@sap:label}"
            />
        </table:label>
        <table:template>
            <Image
                id="FioriTools::ColumnExtension0Image"
                src="{picture}"
                height="4rem"
                lazyLoading="true"
                decorative="false"
                densityAware="false"
            >
                <detailBox>
                    <LightBox id="FioriTools::ColumnExtension0LightBox">
                        <LightBoxItem
                            id="FioriTools::ColumnExtension0LightBoxItem"
                            imageSrc="{picture}"
                            alt=""
                            title=""
                            subtitle=""
                        />
                    </LightBox>
                </detailBox>
            </Image>
        </table:template>
        <table:customData>
            <core:CustomData
                key="p13nData"
                value="\{&quot;columnIndex&quot;: &quot;1&quot;, &quot;leadingProperty&quot;: &quot;picture&quot;, &quot;columnKey&quot;: &quot;ColumnExtension0&quot;, &quot;sortProperty&quot;: &quot;picture&quot;, &quot;filterProperty&quot;: &quot;picture&quot;}"
            />
        </table:customData>
    </table:Column>
    <table:Column
        id="FioriTools::ColumnExtension1"
        sortProperty="objednavka"
        filterProperty="objednavka"
    >
        <table:label>
            <Label
                id="FioriTools::ColumnExtension1Label"
                text="{/#ZPMI_CKD_CUSTType/objednavka/@sap:label}"
            />
        </table:label>
        <table:template>
            <Link
                id="FioriTools::ColumnExtension1Link"
                text="{objednavka}"
                press="onCallObjednavkaService"
            />
        </table:template>
        <table:customData>
            <core:CustomData
                key="p13nData"
                value="\{&quot;columnIndex&quot;: &quot;8&quot;, &quot;leadingProperty&quot;: &quot;objednavka&quot;, &quot;columnKey&quot;: &quot;ColumnExtension1&quot;, &quot;sortProperty&quot;: &quot;objednavka&quot;, &quot;filterProperty&quot;: &quot;objednavka&quot;}"
            />
        </table:customData>
    </table:Column>
    <table:Column
        id="FioriTools::ColumnExtension"
        sortProperty="spotreba"
        filterProperty="spotreba"
    >
        <table:label>
            <Label
                id="FioriTools::ColumnExtensionLabel"
                text="{/#ZPMI_CKD_CUSTType/spotreba/@sap:label}"
            />
        </table:label>
        <table:template>
            <Link
                id="FioriTools::ColumnExtensionLink"
                text="{spotreba}"
                press="onCallSpotrebaService"
            />
        </table:template>
        <table:customData>
            <core:CustomData
                key="p13nData"
                value="\{&quot;columnIndex&quot;: &quot;7&quot;, &quot;leadingProperty&quot;: &quot;spotreba&quot;, &quot;columnKey&quot;: &quot;ColumnExtension&quot;, &quot;sortProperty&quot;: &quot;spotreba&quot;, &quot;filterProperty&quot;: &quot;spotreba&quot;}"
            />
        </table:customData>
    </table:Column>
    <table:Column
        id="FioriTools::ColumnExtension2"
        sortProperty="kosik"
        filterProperty="kosik"
    >
        <table:label>
            <Label
                id="FioriTools::ColumnExtension2Label"
                text="{/#ZPMI_CKD_CUSTType/kosik/@sap:label}"
            />
        </table:label>
        <table:template>
            <Link
                id="FioriTools::ColumnExtension2Link"
                text="{kosik}"
                press="onCallKosikService"
            />
        </table:template>
        <table:customData>
            <core:CustomData
                key="p13nData"
                value="\{&quot;columnIndex&quot;: &quot;10&quot;, &quot;leadingProperty&quot;: &quot;kosik&quot;, &quot;columnKey&quot;: &quot;ColumnExtension2&quot;, &quot;sortProperty&quot;: &quot;kosik&quot;, &quot;filterProperty&quot;: &quot;kosik&quot;}"
            />
        </table:customData>
    </table:Column>
    <table:Column
        id="FioriTools::ColumnExtension3"
        sortProperty="pobj"
        filterProperty="pobj"
    >
        <table:label>
            <Label
                id="FioriTools::ColumnExtension3Label"
                text="{/#ZPMI_CKD_CUSTType/pobj/@sap:label}"
            />
        </table:label>
        <table:template>
            <Link
                id="FioriTools::ColumnExtension3Link"
                text="{pobj}"
                press="onCallPobjService"
            />
        </table:template>
        <table:customData>
            <core:CustomData
                key="p13nData"
                value="\{&quot;columnIndex&quot;: &quot;9&quot;, &quot;leadingProperty&quot;: &quot;pobj&quot;, &quot;columnKey&quot;: &quot;ColumnExtension3&quot;, &quot;sortProperty&quot;: &quot;pobj&quot;, &quot;filterProperty&quot;: &quot;pobj&quot;}"
            />
        </table:customData>
    </table:Column>
    <table:Column
        id="FioriTools::ColumnExtension4"
        sortProperty="matnr"
        filterProperty="matnr"
    >
        <table:label>
            <Label
                id="FioriTools::ColumnExtension4Label"
                text="{/#ZPMI_CKD_CUSTType/matnr/@sap:label}"
            />
        </table:label>
        <table:template>
            <Link
                id="matnrMenuGrid"
                text="{matnr}"
                press="onMatnrMenuPress"
                ariaHasPopup="Menu"
            />
        </table:template>
        <table:customData>
            <core:CustomData
                key="p13nData"
                value="\{&quot;columnIndex&quot;: &quot;2&quot;, &quot;leadingProperty&quot;: &quot;matnr&quot;, &quot;columnKey&quot;: &quot;ColumnExtension4&quot;, &quot;sortProperty&quot;: &quot;matnr&quot;, &quot;filterProperty&quot;: &quot;matnr&quot;}"
            />
        </table:customData>
    </table:Column>
    <table:Column
        id="FioriTools::ColumnExtension5"
        sortProperty="bdmng"
        filterProperty="bdmng"
    >
        <table:label>
            <Label
                id="FioriTools::ColumnExtension5Label"
                text="{/#ZPMI_CKD_CUSTType/bdmng/@sap:label}"
            />
        </table:label>
        <table:template>
            <Link
                id="FioriTools::ColumnExtension5Link"
                text="{bdmng}"
                press="onCallBdmngService"
            />
        </table:template>
        <table:customData>
            <core:CustomData
                key="p13nData"
                value="\{&quot;columnIndex&quot;: &quot;11&quot;, &quot;leadingProperty&quot;: &quot;bdmng&quot;, &quot;columnKey&quot;: &quot;ColumnExtension5&quot;, &quot;sortProperty&quot;: &quot;bdmng&quot;, &quot;filterProperty&quot;: &quot;bdmng&quot;}"
            />
        </table:customData>
    </table:Column>

    <table:Column
        id="FioriTools::ColumnExtension6"
        sortProperty="noteCnt"
        filterProperty="noteCnt"
    >
        <table:label>
            <Label
                id="FioriTools::ColumnExtension6Label"
                text="Poznámky"
            />
        </table:label>
        <table:template>
            <Button
                id="FioriTools::ColumnExtension6Link"
                icon="sap-icon://notes"
                text="{noteCnt}"
                type="Transparent"
                tooltip="Zobrazit poznámky"
                press="onOpenNotes"
                visible="{= ${noteCnt} > 0 }"
            />
        </table:template>
        <table:customData>
            <core:CustomData
                key="p13nData"
                value="\{&quot;columnIndex&quot;: &quot;12&quot;, &quot;leadingProperty&quot;: &quot;noteCnt&quot;, &quot;columnKey&quot;: &quot;ColumnExtension6&quot;, &quot;sortProperty&quot;: &quot;noteCnt&quot;, &quot;filterProperty&quot;: &quot;noteCnt&quot;}"
            />
        </table:customData>
    </table:Column>

    <table:Column
        id="FioriTools::ColumnExtension7"
        sortProperty="scrap"
        filterProperty="scrap"
    >
        <table:label>
            <Label
                id="FioriTools::ColumnExtension7Label"
                text="Připraveno ke šrotaci"
            />
        </table:label>
        <table:template>
            <CheckBox
                selected="{scrap}"
                select="onScrapSelect"
                busyIndicatorDelay="0"
            />
        </table:template>
        <table:customData>
            <core:CustomData
                key="p13nData"
                value="\{&quot;columnIndex&quot;: &quot;13&quot;, &quot;leadingProperty&quot;: &quot;scrap&quot;, &quot;columnKey&quot;: &quot;ColumnExtension7&quot;, &quot;sortProperty&quot;: &quot;scrap&quot;, &quot;filterProperty&quot;: &quot;scrap&quot;}"
            />
        </table:customData>
    </table:Column>
</core:FragmentDefinition>
