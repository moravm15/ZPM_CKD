        <table:label>
            <Label id="FioriTools::ColumnExtension0Label" text="{/#ZPMI_CKD_CUSTType/picture/@sap:label}"/>
        </table:label>
        <table:template>
            <Image
                id="FioriTools::ColumnExtension0Image"
                src="{picture}"
                height="2rem"
                lazyLoading="true"
                decorative="false"
                densityAware="false"
            >
                <detailBox>
                    <LightBox id="FioriTools::ColumnExtension0LightBox">
                        <LightBoxItem
                            id="FioriTools::ColumnExtension0LightBoxItem"
                            imageSrc="{picture}"
                            alt=""
                            title=""
                            subtitle=""
                        />
                    </LightBox>
                </detailBox>
            </Image>
        </table:template>
        <table:customData>
            <core:CustomData key="p13nData" value="\{&quot;columnIndex&quot;: &quot;1&quot;, &quot;leadingProperty&quot;: &quot;picture&quot;, &quot;columnKey&quot;: &quot;ColumnExtension0&quot;, &quot;sortProperty&quot;: &quot;picture&quot;, &quot;filterProperty&quot;: &quot;picture&quot;}"/>
