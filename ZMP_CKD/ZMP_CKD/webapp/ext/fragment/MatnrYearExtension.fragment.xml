<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
>
    <Dialog
        id="matnrYearDialog"
        afterClose="matnrYearDialogAfterclose"
        draggable="true"
        resizable="true"
        title="{materialYear>/title}"
    >
        <smartTable:SmartTable
            id="matnrYearSmartTable"
            entitySet="ZPMI_CKD_VYDEJ_MAT"
            tableType="ResponsiveTable"
            useExportToExcel="true"
            showRowCount="true"
            persistencyKey="SmartTableAnalytical_Explored"
            enableAutoBinding="true"
            class="sapUiResponsiveContentPadding"
            useTablePersonalisation="true"
            showTablePersonalisation="true"
            placeToolbarInTable="true"
            editable="false"
            useVariantManagement="false"
            beforeRebindTable="onBeforeRebindYearMat"
        />
        <beginButton>
            <Button
                text="Zavřít"
                press="onMatnrYearCloseDialog"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
