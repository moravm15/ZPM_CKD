<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:ndc="sap.ndc"
>
    <Dialog
        id="PoznamkaDialog"
        title="{materialNoteModel>/matnr} {materialNoteModel>/maktx}"
        resizable="true"
        draggable="true"
        beforeOpen="poznamkaDialogBeforeOpen"
        afterClose="poznamkaDialogAfterClose"
        busyIndicatorDelay="0"
    >
        <content>
            <FeedInput
                post="onMatnrPoznamkaAccept"
                tooltip="Zadejte poznámku"
                maxLength="256"
                value="{materialNoteModel>/note}"
                class="sapUiSmallMarginTopBottom"
            />
            <List
                showSeparators="Inner"
                items="{path:'poznamkyModel>/results/', sorter: [{path:'timestamp', descending : true}]}"
            >
                <FeedListItem
                    id="feedList"
                    sender="{poznamkyModel>poster}"
                    senderPress="onSenderPress"
                    iconDensityAware="false"
                    timestamp="{
                                path: 'poznamkyModel>timestamp',
                                type: 'sap.ui.model.odata.type.DateTime',
                                formatOptions: {
                                    style: 'medium',
                                    UTC: false
                                }
                            }"
                    text="{poznamkyModel>note}"
                    convertLinksToAnchorTags="All"
                />
            </List>
        </content>
        <buttons>
            <Button
                icon="sap-icon://decline"
                text="Zavřít"
                tooltip="Zrušit"
                press="onMatnrPoznamkaDecline"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
