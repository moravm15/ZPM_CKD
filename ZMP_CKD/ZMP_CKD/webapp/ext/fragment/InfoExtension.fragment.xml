<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:smartTable="sap.ui.comp.smarttable" xmlns:smartFilterBar="sap.ui.comp.smartfilterbar">
    <Dialog id="infoDialog" afterOpen="afterInfoDialogOpen" title="Infozáznamy">
        <smartTable:SmartTable
            id="infoSmartTable"
            entitySet="ZPMI_CKD_EINA"
            tableType="ResponsiveTable"
            useExportToExcel="true"
            showRowCount="true"
            persistencyKey="infoSmartTableAnalytical_Explored"
            enableAutoBinding="true"
            class="sapUiResponsiveContentPadding"
            useTablePersonalisation="true"
            showTablePersonalisation="true"
            placeToolbarInTable="true"
            editable="false"
            useVariantManagement="false"
            beforeRebindTable="onBeforeRebindInfo"
            initiallyVisibleFields="infnr,aplfz,werks,ekorg,esokz,matnr,maktx,idnlf,lifnr,name1"
        >

        </smartTable:SmartTable>
        <beginButton>
            <Button text="Zavřít"  press="onInfoCloseDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
