<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:ndc="sap.ndc"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
>
    <Dialog
        id="HladinaDialog"
        title="Změna Hladiny"
        afterClose="mdmaHistDialogAfterclose"
        resizable="true"
        draggable="true"
        busyIndicatorDelay="0"
    >
        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="2"
                emptySpanL="2"
                emptySpanM="2"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
            >
                <f:content>
                    <Label text="Materiál" />
                    <Text text="{hladinaModel>/matnr} {hladinaModel>/maktx}" />
                    <Label text="Objednací hladina" />
                    <Input
                        name="Objednací hladina"
                        type="Number"
                        value="{hladinaModel>/minbe}"
                    />
                    <Label text="Maximální skladová zásoba" />
                    <Input
                        name="Maximální skladová zásoba"
                        type="Number"
                        value="{hladinaModel>/mabst}"
                    />
                    <Label text="Historie" />
                    <smartTable:SmartTable
                        id="MdmaHistTable"
                        entitySet="ZPMI_CKD_MDMA_HIST"
                        tableType="ResponsiveTable"
                        useExportToExcel="true"
                        showRowCount="true"
                        persistencyKey="SmartTableAnalytical_Explored"
                        initiallyVisibleFields="ChangedField,OldValue,NewValue,ChangeDate,ChangeTime,ChangedBy"
                        enableAutoBinding="true"
                        class="sapUiResponsiveContentPadding"
                        useTablePersonalisation="true"
                        showTablePersonalisation="true"
                        placeToolbarInTable="true"
                        editable="false"
                        useVariantManagement="false"
                        beforeRebindTable="onBeforeMdmaHistTableRebind"
                    />
                </f:content>
            </f:SimpleForm>
        </content>
        <buttons>
            <Button
                icon="sap-icon://accept"
                text="Potvrdit"
                tooltip="Potvrdit"
                press="onHladinaAccept"
                type="Emphasized"
            />
            <Button
                icon="sap-icon://decline"
                text="Zrušit"
                tooltip="Zrušit"
                press="onHladinaDecline"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
